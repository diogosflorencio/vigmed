# --- App -----
NEXT_PUBLIC_APP_NAME=VIGMED
NEXT_PUBLIC_ROOT_DOMAIN=vigmed.com.br

# Dev: simula subdomínio quando localhost (site | adm | docs | blog)
VIGMED_DEV_TENANT=site

# --- Supabase ---
# URL: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Chave publishable (Dashboard → Settings → API → Publishable key)
# Equivale à antiga "anon key"
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Chave secret (Dashboard → Settings → API → Secret key)
# Apenas servidor - nunca expor no client
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# Referência do projeto (para supabase gen types)
SUPABASE_PROJECT_ID=your-project-ref

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=vigmed-docs
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# URLs de redirect do Supabase Auth (OAuth, convite, magic link, recuperar senha)
# Devem estar em Supabase → Authentication → URL Configuration → Redirect URLs
# Ex.: http://localhost:3000/api/auth/callback, https://docs.vigmed.com.br/api/auth/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000
NEXT_PUBLIC_DOCS_URL=http://localhost:3000
NEXT_PUBLIC_BLOG_URL=http://localhost:3000/blog
